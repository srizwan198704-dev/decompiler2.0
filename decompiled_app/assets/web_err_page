<!DOCTYPE html>
<html>
  <head>
    <title>#_PAGE_TITLE_#</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: #fff;
        -webkit-tap-highlight-color: transparent;
      }
      .container {
        width: 100%;
        box-sizing: border-box;
        margin: 0 auto;
        padding: 0 40px;
        box-shadow: none;
        transform: translateY(-20%);
      }
      .top-image {
        width: 4.5rem;
        height: 4.5rem;
        margin-bottom: 1.2rem;
        background-image: url('data:image/png;base64,');
        background-size: cover;
        background-position: center;
        margin: 0 auto;
      }
      h1 {
        font-family: 'Roboto-Medium', sans-serif;
        font-size: 1rem;
        color: #525e66;
        letter-spacing: 0;
        text-align: center;
        font-weight: 500;
        margin-bottom: 0.2rem;
      }
      p {
        font-family: Roboto-Black;
        font-size: 12px;
        color: #aab5bb;
        letter-spacing: 0;
        text-align: center;
        line-height: 17px;
        font-weight: 400;
        margin-top: 6px;
        margin-bottom: 30px;
      }
      a {
        color: #007bff;
        text-decoration: none;
      }
      .button {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        font-size: 1.4rem;
        font-weight: bold;
        height: 3rem;
        border-radius: 10px;
        cursor: pointer;
        margin-top: 1rem;
        font-family: Roboto-Medium;
        font-size: 14px;
        font-weight: 500;
      }

      .button-corner,
      .both-corner {
        position: absolute;
        top: 0;
        right: -6px;
        padding: 5px 8px;
        font-family: Roboto-Bold;
        font-size: 10px;
        color: #ffffff;
        font-weight: 700;
        transform: translateY(-70%);
        background: #2696ff;
        border-radius: 6px 6px 6px 0;
        display: none;
      }
      .bothBtn .both-corner {
        padding: 3px 8px;
        background-image: linear-gradient(270deg, #ff7342 0%, #ff3f1f 100%);
      }

      .button img {
        width: 1rem;
        height: 1rem;
        margin-right: 5px;
      }
      .diagnostics-button {
        background-color: #000;
        color: #fff;
        border: none;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .refresh-button,
      .refresh-button2 {
        background-color: #f5f6f7;
        color: #333;
        border: none;
        border-radius: 10px;
      }
      .refresh-button2 {
        display: none;
        margin-bottom: 20px;
      }
      .bothBtn {
        display: none;
        position: relative;
        background: #fffaee;
        font-family: Roboto-Medium;
        font-size: 14px;
        color: #c47d2d;
        text-align: center;
        font-weight: 500;
        border: none;
        margin-top: 22px;
      }

      .bothBtn::before {
        content: '';
        position: absolute;
        top: -0.5px;
        left: -0.5px;
        right: -0.5px;
        bottom: -0.5px;
        background: linear-gradient(135deg, #ffebc7, #ffdfa3);
        z-index: -1;
        border-radius: 10px; /* 与外层圆角一致 */
      }

      .feedback-link {
        width: 100%;
        box-sizing: border-box;
        position: fixed;
        display: block;
        bottom: 36px;
        padding: 0 40px;
        left: 50%;
        transform: translateX(-50%);
      }

      .feedback-link-text {
        font-family: 'Roboto-Regular', sans-serif;
        font-size: 0.75rem;
        color: #b0b7bb;
        letter-spacing: 0;
        font-family: Roboto-Regular;
        font-weight: 400;
        text-decoration: underline;
        margin: 0 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top-image"></div>
      <h1 class="main-title">#_MAIN_TITLE_#</h1>
      <p class="sub-title">#_SUB_TITLE_#</p>
      <button id="mainBtn" class="button diagnostics-button">
        <img
          style="display: none"
          src="data:image/png;base64,"
          alt=""
        />
        #_BUTTON_TEXT_1_#
        <span class="button-corner"></span>
      </button>
      <button id="refreshBtn" class="button refresh-button">
        <img
          src="data:image/png;base64,"
          alt=""
        />
        #_BUTTON_TEXT_2_#
      </button>
      <button id="bothBtn" class="button bothBtn">
        #_BUTTON_TEXT_3_#
        <span class="both-corner"></span>
      </button>
    </div>
    <div class="feedback-link">
      <button id="refreshBtn2" class="button refresh-button2">
        <img
          src="data:image/png;base64,"
          alt=""
        />
        #_BUTTON_TEXT_2_#
      </button>
      <a href="ext:feedback:web_error" class="feedback-link-text"
        >#_BUTTON_TEXT_FEEDBACK_#</a
      >
      <a href="ext:error_check:check" class="feedback-link-text"
        >#_BUTTON_TEXT_DIAGNOSTICS_#</a
      >
    </div>

    <script>
      const PAGE_TYPE = '#_PAGE_TYPE_#'; // 值范围 REFRESH / TURN_VPN / VPN_BOTH
      const IS_TURN_PAGE = PAGE_TYPE === 'TURN_VPN';
      const IS_VPN_BOTH = PAGE_TYPE === 'VPN_BOTH';
      // true的时候，第二个按钮需要展示refresh图标

      const mainBtn = document.getElementById('mainBtn');
      const refreshBtn = document.getElementById('refreshBtn');
      const refreshBtn2 = document.getElementById('refreshBtn2');
      const bothBtn = document.getElementById('bothBtn');

      if (IS_TURN_PAGE) {
        const cornerTextTag = '#_MAIN_BUTTON_CORNER_TEXT_#';
        const cornerText =
          cornerTextTag?.indexOf('CORNER_TEXT') === -1
            ? cornerTextTag
            : 'Turn vpn & Retry';
        if (cornerText) {
          mainBtn.querySelector('.button-corner').innerText = cornerText;
          mainBtn.querySelector('.button-corner').style.display = 'flex';
        }
        refreshBtn.querySelector('img').style.display = 'inline-block';
      } else if (IS_VPN_BOTH) {
        const showBothBtn = '#_BOTH_BTN_SHOW_#';
        const cornerTextTag = '#_MAIN_BOTH_CORNER_TEXT_#';
        const cornerText =
          cornerTextTag?.indexOf('CORNER_TEXT') === -1
            ? cornerTextTag
            : 'Turn vpn & Retry';
        if (cornerText) {
          bothBtn.querySelector('.both-corner').innerText = cornerText;
          bothBtn.querySelector('.both-corner').style.display =
            showBothBtn === 'true' ? 'flex' : 'none';
        }
        refreshBtn.style.display = 'none';
        bothBtn.style.display = showBothBtn === 'true' ? 'block' : 'none';
        refreshBtn2.style.display = 'flex';
      } else {
        mainBtn.querySelector('img').style.display = 'inline-block';
        refreshBtn.style.display = 'none';
      }

      mainBtn.addEventListener('click', () => {
        location.href = '#_MAIN_BTN_CLICK_STRING_#';
      });

      bothBtn.addEventListener('click', () => {
        location.href = '#_BOTH_BTN_CLICK_STRING_#';
      });

      refreshBtn.addEventListener('click', () => {
        location.href = 'ext:refresh';
      });

      refreshBtn2.addEventListener('click', () => {
        location.href = 'ext:refresh';
      });
    </script>
  </body>
</html>
