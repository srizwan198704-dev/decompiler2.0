<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@color/c_ebeced" android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/device_recom_bg" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_15" android:layout_marginRight="@dimen/dp_15" android:layout_marginStart="@dimen/dp_15" android:layout_marginEnd="@dimen/dp_15">
        <TextView android:textSize="@dimen/dp_17" android:textStyle="bold" android:textColor="@color/window_txt_color_bcc" android:id="@id/dialog_home_device_reco_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_30" android:layout_marginBottom="@dimen/dp_10" android:text="@string/cast_screen_card_title" />
        <ImageView android:id="@id/dialog_home_device_reco_img" android:layout_width="wrap_content" android:layout_height="@dimen/dp_100" android:src="@drawable/image_dialog_cast" android:layout_below="@id/dialog_home_device_reco_name" />
        <TextView android:textSize="@dimen/dp_13" android:textColor="@color/window_txt_color_b66" android:id="@id/dialog_home_device_reco_desc" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_10" android:text="@string/home_device_detail_recommend_desc_dialog" android:layout_below="@id/dialog_home_device_reco_img" />
    </RelativeLayout>
    <RelativeLayout android:id="@id/device_install_rl" android:paddingBottom="@dimen/dp_30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_15" android:layout_marginTop="@dimen/dp_30" android:layout_marginRight="@dimen/dp_15" android:layout_below="@id/device_recom_bg" android:layout_marginStart="@dimen/dp_15" android:layout_marginEnd="@dimen/dp_15">
        <TextView android:textSize="@dimen/dp_17" android:textStyle="bold" android:textColor="@color/window_txt_color_bcc" android:id="@id/dialog_home_device_install_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cast_screen_recom_phone_install_dialog_title" />
        <TextView android:textSize="@dimen/dp_13" android:textColor="@color/window_txt_color_b66" android:id="@id/dialog_home_device_install_desc" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_10" android:text="@string/home_device_detail_recommend_tv_install_desc_dialog" android:layout_below="@id/dialog_home_device_install_name" />
        <RelativeLayout android:id="@id/device_install_web_rl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:layout_below="@id/dialog_home_device_install_desc">
            <ImageView android:id="@id/dialog_device_web_icon" android:layout_width="@dimen/dp_36" android:layout_height="@dimen/dp_36" android:layout_marginRight="@dimen/dp_10" android:src="@drawable/image_dialog_web" android:scaleType="centerCrop" android:layout_marginEnd="@dimen/dp_10" />
            <TextView android:textSize="@dimen/dp_15" android:textColor="@color/window_txt_color_bcc" android:ellipsize="end" android:id="@id/dialog_device_web_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_device_detail_recommend_tv_install_ad_dialog" android:singleLine="true" android:layout_toRightOf="@id/dialog_device_web_icon" android:layout_toEndOf="@id/dialog_device_web_icon" />
            <TextView android:textSize="@dimen/dp_13" android:textColor="@color/c_2274e6" android:ellipsize="end" android:id="@id/dialog_device_wifi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:text="@string/home_device_detail_recommend_tv_install_baidu_dialog" android:singleLine="true" android:layout_toRightOf="@id/dialog_device_web_icon" android:layout_below="@id/dialog_device_web_address" android:layout_toEndOf="@id/dialog_device_web_icon" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:layout_below="@id/device_install_web_rl">
            <ImageView android:id="@id/dialog_device_gp_icon" android:layout_width="@dimen/dp_36" android:layout_height="@dimen/dp_36" android:layout_marginRight="@dimen/dp_10" android:src="@drawable/image_dialog_gp" android:scaleType="centerCrop" android:layout_marginEnd="@dimen/dp_10" />
            <TextView android:textSize="@dimen/dp_15" android:textColor="@color/window_txt_color_bcc" android:ellipsize="end" android:id="@id/dialog_device_gp_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_device_detail_recommend_tv_install_gp_dialog" android:singleLine="true" android:layout_toRightOf="@id/dialog_device_gp_icon" android:layout_centerInParent="true" android:layout_toEndOf="@id/dialog_device_gp_icon" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>