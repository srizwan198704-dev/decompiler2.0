<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <com.uc.browser.core.download.DownLoadLightMoveLayout android:gravity="center" android:id="@id/download_complete_banner_save_light_layout" android:layout_width="fill_parent" android:layout_height="@dimen/download_complete_banner_save_height">
        <ImageView android:id="@id/download_complete_banner_save_im" android:layout_width="@dimen/download_complete_banner_save_drawable_width" android:layout_height="@dimen/download_complete_banner_save_drawable_height" android:scaleType="fitXY" />
        <TextView android:textSize="@dimen/download_complete_banner_save_text_size" android:ellipsize="end" android:gravity="center" android:id="@id/download_complete_banner_save_tv" android:paddingLeft="@dimen/download_complete_banner_save_pad" android:paddingRight="@dimen/download_complete_banner_save_pad" android:layout_width="wrap_content" android:layout_height="fill_parent" android:maxLines="1" />
    </com.uc.browser.core.download.DownLoadLightMoveLayout>
    <LinearLayout android:gravity="center_vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/download_complete_banner_msg_mar_left" android:layout_marginTop="@dimen/download_complete_banner_msg_mar_top" android:layout_marginRight="@dimen/download_complete_banner_msg_mar_left">
        <ImageView android:id="@id/download_complete_banner_msg_icon" android:layout_width="@dimen/download_complete_banner_msg_drawable_size" android:layout_height="@dimen/download_complete_banner_msg_drawable_size" android:layout_marginRight="@dimen/download_complete_banner_msg_drawable_pad" android:scaleType="centerCrop" />
        <TextView android:textSize="@dimen/download_complete_banner_msg_text_size" android:ellipsize="middle" android:gravity="left" android:id="@id/download_complete_banner_msg" android:layout_width="fill_parent" android:layout_height="wrap_content" android:maxLines="2" />
    </LinearLayout>
    <include android:id="@id/download_complete_banner_add_fav_layout" layout="@layout/banner_download_finished_add_fav_layout" />
    <LinearLayout android:gravity="right" android:orientation="horizontal" android:paddingLeft="@dimen/download_complete_banner_action_pad_left" android:paddingTop="@dimen/download_complete_banner_action_pad_top" android:paddingRight="@dimen/download_complete_banner_action_pad_left" android:paddingBottom="@dimen/download_complete_banner_action_pad_bottom" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textSize="@dimen/download_complete_banner_action_text_size" android:ellipsize="end" android:id="@id/download_complete_banner_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/download_complete_banner_ok_mar_right" />
        <TextView android:textSize="@dimen/download_complete_banner_action_text_size" android:ellipsize="end" android:id="@id/download_complete_banner_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>