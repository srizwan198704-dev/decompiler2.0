<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:fitsSystemWindows="true" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.appcompat.widget.Toolbar android:id="@id/ad_unlock_toolbar" android:background="@color/c_es_actionbar_bg" android:layout_width="fill_parent" android:layout_height="@dimen/abc_action_bar_default_height_material" />
    <LinearLayout android:orientation="vertical" android:id="@id/adunlock_container" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_below="@id/ad_unlock_toolbar">
        <RelativeLayout android:gravity="center_vertical" android:background="@color/transparent" android:layout_width="fill_parent" android:layout_height="@dimen/addressbar_height">
            <include layout="@layout/mtd_content_tripple_view_layout" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/ll_adunlcok_catgory_content" android:background="@drawable/adunlock_category_content_bg" android:focusable="true" android:layout_width="fill_parent" android:layout_height="@dimen/addressbar_height">
                <TextView android:textSize="@dimen/dp_15" android:textColor="@color/app_category_text_color" android:ellipsize="end" android:layout_gravity="center_vertical" android:id="@id/tv_adunlock_catgory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_12" android:maxWidth="@dimen/dp_200" android:singleLine="true" />
                <ImageView android:layout_gravity="center_vertical" android:id="@id/iv_adunlock_icon_down_arrow" android:layout_width="@dimen/dp_15" android:layout_height="@dimen/dp_15" android:layout_marginLeft="@dimen/dp_10" android:src="@drawable/icon_downarrow30" />
            </LinearLayout>
        </RelativeLayout>
        <View android:id="@id/divider_tag" android:background="@color/es_base_divider_color" android:layout_width="fill_parent" android:layout_height="@dimen/dp_0.5" />
        <androidx.recyclerview.widget.RecyclerView android:id="@id/ad_unlock_recyclerview" android:paddingBottom="@dimen/dp_5" android:scrollbars="vertical" android:clipToPadding="false" android:layout_width="fill_parent" android:layout_height="fill_parent" />
    </LinearLayout>
</RelativeLayout>