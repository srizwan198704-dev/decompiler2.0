<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:fadeScrollbars="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:textSize="@dimen/wifi_safe_prompt_tip_text_size" android:id="@id/safetip" android:layout_width="fill_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <RelativeLayout android:id="@id/wifi_safe_option1" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ImageView android:id="@id/wifi_safe_option_btn1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
                <LinearLayout android:gravity="center|left" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_toLeftOf="@id/wifi_safe_option_btn1">
                    <TextView android:textSize="@dimen/wifi_safe_prompt_text_size" android:id="@id/wifi_safe_option1_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="@dimen/wifi_safe_prompt_desc_size" android:id="@id/wifi_safe_option1_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@id/wifi_safe_option2" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ImageView android:id="@id/wifi_safe_option_btn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
                <LinearLayout android:gravity="center|left" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_toLeftOf="@id/wifi_safe_option_btn2">
                    <TextView android:textSize="@dimen/wifi_safe_prompt_text_size" android:id="@id/wifi_safe_option2_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="@dimen/wifi_safe_prompt_desc_size" android:id="@id/wifi_safe_option2_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout android:id="@id/wifi_safe_option3" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ImageView android:id="@id/wifi_safe_option_btn3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
                <LinearLayout android:gravity="center|left" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_toLeftOf="@id/wifi_safe_option_btn3">
                    <TextView android:textSize="@dimen/wifi_safe_prompt_text_size" android:id="@id/wifi_safe_option3_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:textSize="@dimen/wifi_safe_prompt_desc_size" android:id="@id/wifi_safe_option3_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>