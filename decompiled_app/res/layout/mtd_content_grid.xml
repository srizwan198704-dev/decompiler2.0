<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:gravity="center" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/mtd_content_tripple_view_layout" />
    <include layout="@layout/mtd_content_empty_view_layout" />
    <include layout="@layout/mtd_content_gdrive_guide_view_layout" />
    <RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <include android:id="@id/address_layout" layout="@layout/window_addressbar" />
        <androidx.coordinatorlayout.widget.CoordinatorLayout android:orientation="vertical" android:id="@id/coordinator_layout" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_above="@id/content_bottom_rl" android:layout_below="@id/address_layout">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@id/refresh_layout" android:layout_width="fill_parent" android:layout_height="fill_parent">
                <com.estrongs.android.ui.view.FlingChangeRecyclerView android:id="@id/grid_view" android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <View android:id="@id/mtd_content_grid_addressbar_bottom_line" android:background="@color/es_base_divider_color" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="@dimen/dp_1" app:layout_behavior="com.estrongs.android.ui.recycler.AddressBarBottomBehavior" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <com.estrongs.android.ui.fastscroller.vertical.VerticalRecyclerViewFastScroller android:id="@id/fast_scroller" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_alignParentRight="true" app:rfs_handleBackground="@drawable/icon_handle" />
        <RelativeLayout android:id="@id/head_view_analysis" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_below="@id/address_layout" />
        <com.estrongs.android.widget.ESViewStub android:id="@id/web_view_stub" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_above="@id/content_bottom_rl" android:layout_alignParentTop="true" />
        <RelativeLayout android:id="@id/content_bottom_rl" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
            <LinearLayout android:gravity="center" android:id="@id/grid_footer" android:background="#64000000" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <ProgressBar android:id="@id/grid_footer_progressbar" android:layout_width="@dimen/dp_16" android:layout_height="@dimen/dp_16" style="@style/ProgressBar" />
                <TextView android:textSize="@dimen/dp_16" android:gravity="center" android:id="@id/grid_footer_text" android:background="@drawable/background_globle_buttons" android:paddingTop="5.0dip" android:paddingBottom="5.0dip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/loading_more_msg" />
            </LinearLayout>
            <FrameLayout android:id="@id/scan_net_layout" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_below="@id/grid_footer">
                <Button android:id="@id/btn_network_scan" android:text="@string/action_scan" style="@style/base_bottom_btn_style" />
                <ProgressBar android:layout_gravity="center|right" android:id="@id/net_scan_progress" android:visibility="invisible" android:layout_width="@dimen/dp_20" android:layout_height="@dimen/dp_20" android:layout_marginRight="@dimen/dp_50" android:layout_marginBottom="@dimen/dp_5" style="@style/ProgressBar" />
            </FrameLayout>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:id="@id/progressView" android:background="@drawable/loading_bg" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ProgressBar" />
        <TextView android:textColor="@color/window_txt_color_b66" android:id="@id/progressMessage" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>