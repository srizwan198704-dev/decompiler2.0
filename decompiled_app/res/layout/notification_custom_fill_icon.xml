        <LinearLayout android:orientation="vertical" android:id="@id/custom_notification_fill_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toLeftOf="@id/custom_notification_fill_tip" android:layout_alignParentLeft="true">
