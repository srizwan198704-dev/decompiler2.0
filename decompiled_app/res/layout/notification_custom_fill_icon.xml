<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@color/notification_custom_bg_color" android:paddingRight="@dimen/notification_custom_padding_right" android:layout_width="fill_parent" android:layout_height="fill_parent" android:minHeight="@dimen/notification_large_icon_height"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/custom_notification_fill_icon" android:layout_width="@dimen/notification_large_icon_height" android:layout_height="@dimen/notification_large_icon_height" android:scaleType="centerCrop" android:layout_alignParentLeft="true" android:layout_centerVertical="true" />
