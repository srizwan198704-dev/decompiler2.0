        <Button android:id="@id/load_biz_type_banner_ad" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="加载业务配置banner广告" />
        <Button android:id="@id/open_inspector" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="打开Admob调试面板" />
        <Button android:id="@id/open_topon_inspector" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="打开Topon调试面板" />
        <Button android:id="@id/open_noah_inspector" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="打开Noah调试面板" />
