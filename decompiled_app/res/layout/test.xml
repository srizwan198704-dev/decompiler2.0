        <Button android:id="@id/load_uc_reward_ad" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="加载UC兜底激励广告" />
        <Button android:id="@id/load_banner_ad" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="加载Banner广告" />
        <Button android:id="@id/preload_banner_ad" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="预加载Banner广告" />
