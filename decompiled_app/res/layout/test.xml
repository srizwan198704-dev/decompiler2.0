        <EditText android:id="@id/ad_uint_id" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="ucdrive_banner_ad" android:hint="广告位id/bizType" />
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="banner width" />
            <EditText android:id="@id/banner_width" android:layout_width="0.0dip" android:layout_height="wrap_content" android:text="320" android:layout_weight="1.0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="banner height" />
            <EditText android:id="@id/banner_height" android:layout_width="0.0dip" android:layout_height="wrap_content" android:text="50" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <CheckBox android:textSize="16.0sp" android:id="@id/platform_filter_checkbox" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Topon 广告 ADN 过滤" />
            <EditText android:textSize="16.0sp" android:id="@id/placement_id_edit_text" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:hint="Slot（留空则全局屏蔽）" />
            <androidx.recyclerview.widget.RecyclerView android:id="@id/platform_recycler_view" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" app:spanCount="5" />
