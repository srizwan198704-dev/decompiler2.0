<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:paddingRight="@dimen/push_sdk_notification_custom_padding_right" android:layout_width="fill_parent" android:layout_height="fill_parent" android:minHeight="@dimen/notification_large_icon_height"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/notification_custom_video_icon_layout" android:layout_width="@dimen/push_sdk_notification_video_icon_width" android:layout_height="@dimen/notification_large_icon_height" android:layout_alignParentLeft="true" android:layout_centerVertical="true">
        <ImageView android:id="@id/custom_notification_video_icon" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:contentDescription="@string/null_string" />
        <TextView android:textSize="@dimen/push_sdk_notification_mark_text_size" android:textColor="@color/notification_custom_mark_color" android:ellipsize="end" android:gravity="center" android:id="@id/custom_notification_mark" android:background="@color/notification_custom_mark_bg_color" android:paddingLeft="@dimen/push_sdk_notification_custom_mark_pad_left" android:paddingTop="@dimen/push_sdk_notification_custom_mark_pad_top" android:paddingRight="@dimen/push_sdk_notification_custom_mark_pad_left" android:paddingBottom="@dimen/push_sdk_notification_custom_mark_pad_top" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
        <ImageView android:layout_gravity="center" android:id="@id/custom_notification_video_im" android:visibility="gone" android:layout_width="@dimen/push_sdk_notification_custom_video_icon_width" android:layout_height="@dimen/push_sdk_notification_custom_video_icon_width" />
    </FrameLayout>
    <RelativeLayout android:gravity="center_vertical" android:paddingLeft="@dimen/push_sdk_notification_content_padding_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toLeftOf="@id/tip_layout" android:layout_toRightOf="@id/notification_custom_video_icon_layout" android:layout_centerVertical="true">
        <LinearLayout android:orientation="vertical" android:id="@id/custom_notification_video_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true">
            <TextView android:textSize="@dimen/push_sdk_notification_custom_title_size" android:textColor="@color/notification_custom_title_color" android:ellipsize="end" android:id="@id/custom_notification_video_title" android:padding="0.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:maxLines="2" />
