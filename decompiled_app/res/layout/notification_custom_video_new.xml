        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout android:id="@id/tip_layout" android:layout_width="wrap_content" android:layout_height="@dimen/push_sdk_notification_large_icon_height" android:layout_alignParentRight="true">
        <TextView android:id="@id/custom_notification_fill_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" style="@style/PushSdkNotificationText" />
        <ImageView android:id="@id/custom_notification_fill_tip" android:layout_width="@dimen/push_sdk_notification_custom_small_icon_width" android:layout_height="@dimen/push_sdk_notification_custom_small_icon_width" android:src="@drawable/notification_small_icon" android:scaleType="centerCrop" android:layout_above="@id/custom_notification_fill_time" android:layout_alignRight="@id/custom_notification_fill_time" android:layout_alignParentBottom="true" />
    </RelativeLayout>
</RelativeLayout>