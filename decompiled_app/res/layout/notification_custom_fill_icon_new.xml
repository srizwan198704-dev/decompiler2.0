<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:paddingRight="@dimen/push_sdk_notification_custom_padding_right" android:layout_width="fill_parent" android:layout_height="fill_parent" android:minHeight="@dimen/notification_large_icon_height"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/custom_notification_fill_icon" android:layout_width="@dimen/notification_large_icon_height" android:layout_height="@dimen/notification_large_icon_height" android:scaleType="centerCrop" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:contentDescription="@string/null_string" />
    <RelativeLayout android:gravity="center_vertical" android:paddingLeft="@dimen/push_sdk_notification_content_padding_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toLeftOf="@id/tip_layout" android:layout_toRightOf="@id/custom_notification_fill_icon" android:layout_centerVertical="true">
        <LinearLayout android:orientation="vertical" android:id="@id/custom_notification_fill_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/push_sdk_notification_title_with_time_margin_right" android:layout_alignParentLeft="true">
            <TextView android:textSize="@dimen/push_sdk_notification_custom_title_size" android:textColor="@color/notification_custom_title_color" android:ellipsize="end" android:id="@id/custom_notification_fill_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="2" />
