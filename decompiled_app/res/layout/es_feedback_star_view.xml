<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:padding="@dimen/dp_10" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <RelativeLayout android:background="@drawable/feedback_rating_dialog_bg" android:paddingBottom="@dimen/dp_20" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_41">
            <LinearLayout android:orientation="vertical" android:id="@id/feedback_top_ll" android:paddingLeft="@dimen/dp_10" android:paddingTop="@dimen/dp_15" android:paddingRight="@dimen/dp_10" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textSize="@dimen/dp_18" android:textColor="@color/c_ffffff" android:ellipsize="end" android:gravity="center" android:id="@id/feedback_dialog_title_tv" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_60" android:layout_marginRight="@dimen/dp_60" android:text="@string/feedback_dialog_title" android:maxLines="1" />
                <TextView android:textSize="@dimen/dp_15" android:textColor="@color/c_ccffffff" android:gravity="center" android:id="@id/feedback_dialog_fmsg_tv" android:paddingTop="@dimen/dp_20" android:paddingBottom="@dimen/dp_20" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/feedback_dialog_msg" android:lineSpacingExtra="@dimen/dp_10" />
            </LinearLayout>
            <RatingBar android:id="@id/feedback_rating_bar" android:layout_width="wrap_content" android:layout_height="@dimen/dp_29" android:progressDrawable="@drawable/rating_bar_large_bg" android:numStars="5" android:rating="0.0" android:stepSize="1.0" android:isIndicator="false" android:layout_below="@id/feedback_top_ll" android:layout_centerHorizontal="true" style="?android:ratingBarStyleIndicator" />
            <Button android:textSize="@dimen/dp_17" android:textStyle="bold" android:textColor="@color/feedback_btn_text_selector" android:gravity="center" android:layout_gravity="center_horizontal" android:orientation="horizontal" android:id="@id/feedback_bottom_btn" android:background="@drawable/btn_yellow_selector" android:layout_width="fill_parent" android:layout_height="@dimen/dp_40" android:layout_marginLeft="@dimen/dp_40" android:layout_marginTop="@dimen/dp_36" android:layout_marginRight="@dimen/dp_40" android:text="@string/feedback_rate_5_star_text" android:layout_below="@id/feedback_rating_bar" />
            <ImageView android:id="@id/feedback_hand_iv" android:visibility="invisible" android:clickable="false" android:layout_width="@dimen/dp_22" android:layout_height="wrap_content" android:src="@drawable/feedback_finger" />
            <ImageView android:id="@id/feedback_close_iv" android:padding="@dimen/dp_15" android:layout_width="@dimen/dp_45" android:layout_height="@dimen/dp_45" android:src="@drawable/icon_close24" android:layout_alignParentTop="true" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <ImageView android:id="@id/feedback_top_heart_iv" android:layout_width="wrap_content" android:layout_height="@dimen/dp_65" android:src="@drawable/icon_heart" android:layout_marginStart="@dimen/dp_14" />
    </FrameLayout>
</ScrollView>