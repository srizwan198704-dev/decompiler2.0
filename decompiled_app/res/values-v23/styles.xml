<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Widget.AppCompat.Spinner.Underlined" parent="@android:style/Widget.Material.Spinner.Underlined" />
    <style name="Base.Theme.AppCompat" parent="@style/Base.V23.Theme.AppCompat" />
    <style name="Base.Theme.AppCompat.Light" parent="@style/Base.V23.Theme.AppCompat.Light" />
    <style name="Base.Widget.AppCompat.ActionButton.Overflow" parent="@android:style/Widget.Material.ActionButton.Overflow" />
    <style name="Base.Widget.AppCompat.Button.Borderless.Colored" parent="@android:style/Widget.Material.Button.Borderless.Colored" />
    <style name="Base.Widget.AppCompat.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>
    <style name="Base.Widget.AppCompat.TextView" parent="@android:style/Widget.Material.TextView">
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.ActionBar.Menu" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Menu" />
    <style name="Base.TextAppearance.AppCompat.Widget.Button.Inverse" parent="@android:style/TextAppearance.Material.Widget.Button.Inverse" />
    <style name="Base.Widget.AppCompat.Button.Colored" parent="@android:style/Widget.Material.Button.Colored">
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Widget.Button.Colored</item>
    </style>
    <style name="Base.Widget.AppCompat.RatingBar.Indicator" parent="@android:style/Widget.Material.RatingBar.Indicator" />
    <style name="Base.Widget.AppCompat.RatingBar.Small" parent="@android:style/Widget.Material.RatingBar.Small" />
    <style name="AppTheme" parent="@style/Theme.AppCompat">
        <item name="android:textColorPrimary">@color/white_text</item>
        <item name="android:windowBackground">?color_app_background</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorAccent">@color/accent_material</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/primary_material</item>
        <item name="actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="actionModeCutDrawable">@drawable/ic_action_cut_dark</item>
        <item name="actionModeCopyDrawable">@drawable/ic_action_copy_dark</item>
        <item name="actionModePasteDrawable">@drawable/ic_action_paste_dark</item>
        <item name="actionModeSelectAllDrawable">@drawable/ic_action_select_all_dark</item>
        <item name="actionModeShareDrawable">@drawable/ic_action_share_dark</item>
        <item name="colorPrimary">@color/primary_material</item>
        <item name="colorPrimaryDark">@color/primary_dark_material</item>
        <item name="colorAccent">@color/accent_material</item>
        <item name="color_app_background">@color/app_background</item>
        <item name="color_app_accent">@color/accent_material</item>
        <item name="actionModePaletteDrawable">@drawable/ic_palette_dark</item>
        <item name="actionModeSearchDrawable">@drawable/ic_action_search_dark</item>
        <item name="actionModeGotoDrawable">@drawable/ic_action_goto_dark</item>
        <item name="actionModeLowerDrawable">@drawable/ic_action_lower_dark</item>
        <item name="actionModeUpperDrawable">@drawable/ic_action_upper_dark</item>
        <item name="actionModeCommentDrawable">@drawable/ic_action_comm_dark</item>
        <item name="actionModeTranslateDrawable">@drawable/ic_action_translate_dark</item>
        <item name="actionModeUpDrawable">@drawable/ic_action_up_dark</item>
        <item name="actionModeDownDrawable">@drawable/ic_action_down_dark</item>
        <item name="actionModeLeftDrawable">@drawable/ic_action_left_dark</item>
        <item name="actionModeRightDrawable">@drawable/ic_action_right_dark</item>
        <item name="actionModeSaveDrawable">@drawable/ic_action_save_dark</item>
        <item name="actionModeHelpDrawable">@drawable/ic_action_help_dark</item>
    </style>
    <style name="AppThemeLight" parent="@style/Theme.AppCompat.Light">
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:windowBackground">?color_app_background</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorAccent">@color/accent_material_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/primary_material_light_v23</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionModeStyle">@style/AppThemeLight.ActionMode</item>
        <item name="actionModeCutDrawable">@drawable/ic_action_cut</item>
        <item name="actionModeCopyDrawable">@drawable/ic_action_copy</item>
        <item name="actionModePasteDrawable">@drawable/ic_action_paste</item>
        <item name="actionModeSelectAllDrawable">@drawable/ic_action_select_all</item>
        <item name="actionModeShareDrawable">@drawable/ic_action_share</item>
        <item name="colorPrimary">@color/primary_material_light</item>
        <item name="colorPrimaryDark">@color/primary_dark_material_light</item>
        <item name="colorAccent">@color/accent_material_light</item>
        <item name="color_app_background">@color/app_background_light</item>
        <item name="color_app_accent">@color/accent_material_light</item>
        <item name="actionModePaletteDrawable">@drawable/ic_palette</item>
        <item name="actionModeSearchDrawable">@drawable/ic_action_search</item>
        <item name="actionModeGotoDrawable">@drawable/ic_action_goto</item>
        <item name="actionModeLowerDrawable">@drawable/ic_action_lower</item>
        <item name="actionModeUpperDrawable">@drawable/ic_action_upper</item>
        <item name="actionModeCommentDrawable">@drawable/ic_action_comm</item>
        <item name="actionModeTranslateDrawable">@drawable/ic_action_translate</item>
        <item name="actionModeUpDrawable">@drawable/ic_action_up</item>
        <item name="actionModeDownDrawable">@drawable/ic_action_down</item>
        <item name="actionModeLeftDrawable">@drawable/ic_action_left</item>
        <item name="actionModeRightDrawable">@drawable/ic_action_right</item>
        <item name="actionModeSaveDrawable">@drawable/ic_action_save</item>
        <item name="actionModeHelpDrawable">@drawable/ic_action_help</item>
    </style>
    <style name="Base.V23.Theme.AppCompat" parent="@style/Base.V22.Theme.AppCompat">
        <item name="actionOverflowButtonStyle">?android:actionOverflowButtonStyle</item>
        <item name="actionBarItemBackground">?android:actionBarItemBackground</item>
        <item name="actionMenuTextAppearance">?android:actionMenuTextAppearance</item>
        <item name="actionMenuTextColor">?android:actionMenuTextColor</item>
        <item name="controlBackground">@drawable/abc_control_background_material</item>
        <item name="ratingBarStyleIndicator">?android:ratingBarStyleIndicator</item>
        <item name="ratingBarStyleSmall">?android:ratingBarStyleSmall</item>
    </style>
    <style name="Base.V23.Theme.AppCompat.Light" parent="@style/Base.V22.Theme.AppCompat.Light">
        <item name="actionOverflowButtonStyle">?android:actionOverflowButtonStyle</item>
        <item name="actionBarItemBackground">?android:actionBarItemBackground</item>
        <item name="actionMenuTextAppearance">?android:actionMenuTextAppearance</item>
        <item name="actionMenuTextColor">?android:actionMenuTextColor</item>
        <item name="controlBackground">@drawable/abc_control_background_material</item>
        <item name="ratingBarStyleIndicator">?android:ratingBarStyleIndicator</item>
        <item name="ratingBarStyleSmall">?android:ratingBarStyleSmall</item>
    </style>
</resources>
