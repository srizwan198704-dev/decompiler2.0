<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/preference_security_setting_text"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:layout="@layout/custom_preference_no_space" app:allowDividerAbove="false" app:allowDividerBelow="false">
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_top_radius" android:title="@string/preference_start_protect_title" android:key="start_passwd_enable" android:summary="@string/preference_start_protect_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_net_passwd_title" android:key="net_passwd_enable" android:summary="@string/preference_net_passwd_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_protect_hided_dirfies_title" android:key="hided_dirfiles_passwd_enable" android:summary="@string/preference_protect_hided_dirfies_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <Preference android:persistent="true" android:layout="@layout/custom_preference_bottom_radius" android:title="@string/preference_net_passwd_change_title" android:key="net_passwd_change" android:summary="@string/preference_net_passwd_change_summary" />
    </PreferenceCategory>
</PreferenceScreen>