<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/preference_display_setting_text"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:layout="@layout/custom_preference_no_space" app:allowDividerAbove="false" app:allowDividerBelow="false">
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_top_radius" android:title="@string/preference_show_select" android:key="show_select_button" android:summary="@string/preference_show_select_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_windows" android:key="show_windows_button" android:summary="@string/preference_show_windows_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_bottom_radius" android:title="@string/preference_toolbar_setting_show_name_title" android:key="toolbar_setting_show_name" android:summary="@string/preference_toolbar_setting_show_name_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/custom_preference_category" android:title="@string/location_history" android:key="history" app:allowDividerAbove="false" app:allowDividerBelow="false">
        <CheckBoxPreference android:layout="@layout/custom_preference_full_radius" android:title="@string/pref_show_history_folder_only" android:key="history_dir_only" android:summary="@string/pref_show_history_folder_only_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/custom_preference_category" android:title="@string/pref_title_file_transfer_station" android:key="pref_title_file_transfer_station">
        <CheckBoxPreference android:layout="@layout/custom_preference_full_radius" android:title="@string/pref_open_file_transfer_station" android:key="open_file_transfer_station" android:summary="@string/pref_open_file_transfer_station_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:layout="@layout/custom_preference_category" android:title="@string/others" android:key="others" app:allowDividerAbove="false" app:allowDividerBelow="false">
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_top_radius" android:title="@string/preference_show_home_new_file_title" android:key="show_home_new_file" android:summary="@string/preference_show_home_new_file_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_xlarge_layout" android:key="use_xlarge_layout" android:summary="@string/preference_xlarge_layout_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_sdcard_notification_title" android:key="show_sdcard_notification" android:summary="@string/preference_show_sdcard_notification_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_hidden_file_title" android:key="hidden_file" android:summary="@string/preference_hidden_file_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="false" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/enable_thumbnails_title" android:key="thumbnail" android:summary="@string/summary_show_thumbnail" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/show_associate_app" android:key="show_associate_app" android:summary="@string/summary_show_associate_app" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_scroll_thumb" android:key="scroll_thumb" android:summary="@string/preference_show_scroll_thumb_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_disk_usage" android:key="show_disk_usage" android:summary="@string/preference_show_disk_usage_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_disk_remain" android:key="show_disk_remain" android:summary="@string/preference_show_disk_remain_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_usb_prompt" android:key="show_usb_prompt" android:summary="@string/preference_show_usb_prompt_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
