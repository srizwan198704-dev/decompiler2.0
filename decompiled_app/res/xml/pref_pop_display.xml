        <CheckBoxPreference android:persistent="true" android:layout="@layout/custom_preference_none_radius" android:title="@string/preference_show_clipboard_floating_button_title" android:key="show_clipboard_message" android:summary="@string/preference_show_clipboard_floating_button_summary" android:widgetLayout="@layout/custom_preference_widget_checkbox" android:defaultValue="true" />
        <com.estrongs.android.ui.preference.CustomListPreference android:persistent="true" android:entries="@array/preference_language_setting_entries" android:layout="@layout/custom_preference_bottom_radius" android:title="@string/preference_language_setting_title" android:key="language_setting" android:summary="@string/preference_language_setting_summary" android:widgetLayout="@layout/custom_preference_widget_dialog" android:defaultValue="-1" android:dialogTitle="@string/preference_language_setting_title" android:entryValues="@array/preference_language_setting_values" />
    </PreferenceCategory>
</PreferenceScreen>