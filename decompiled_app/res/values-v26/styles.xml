<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.AppCompat" parent="@style/Base.V26.Theme.AppCompat" />
    <style name="Base.Theme.AppCompat.Light" parent="@style/Base.V26.Theme.AppCompat.Light" />
    <style name="Base.Widget.AppCompat.Toolbar" parent="@style/Base.V26.Widget.AppCompat.Toolbar" />
    <style name="AppThemeLight" parent="@style/Theme.AppCompat.Light">
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:windowBackground">?color_app_background</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorAccent">@color/accent_material_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/primary_material_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionModeStyle">@style/AppThemeLight.ActionMode</item>
        <item name="actionModeCutDrawable">@drawable/ic_action_cut</item>
        <item name="actionModeCopyDrawable">@drawable/ic_action_copy</item>
        <item name="actionModePasteDrawable">@drawable/ic_action_paste</item>
        <item name="actionModeSelectAllDrawable">@drawable/ic_action_select_all</item>
        <item name="actionModeShareDrawable">@drawable/ic_action_share</item>
        <item name="colorPrimary">@color/primary_material_light</item>
        <item name="colorPrimaryDark">@color/primary_dark_material_light</item>
        <item name="colorAccent">@color/accent_material_light</item>
        <item name="color_app_background">@color/app_background_light</item>
        <item name="color_app_accent">@color/accent_material_light</item>
        <item name="actionModePaletteDrawable">@drawable/ic_palette</item>
        <item name="actionModeSearchDrawable">@drawable/ic_action_search</item>
        <item name="actionModeGotoDrawable">@drawable/ic_action_goto</item>
        <item name="actionModeLowerDrawable">@drawable/ic_action_lower</item>
        <item name="actionModeUpperDrawable">@drawable/ic_action_upper</item>
        <item name="actionModeCommentDrawable">@drawable/ic_action_comm</item>
        <item name="actionModeTranslateDrawable">@drawable/ic_action_translate</item>
        <item name="actionModeUpDrawable">@drawable/ic_action_up</item>
        <item name="actionModeDownDrawable">@drawable/ic_action_down</item>
        <item name="actionModeLeftDrawable">@drawable/ic_action_left</item>
        <item name="actionModeRightDrawable">@drawable/ic_action_right</item>
        <item name="actionModeSaveDrawable">@drawable/ic_action_save</item>
        <item name="actionModeHelpDrawable">@drawable/ic_action_help</item>
    </style>
    <style name="Base.V26.Theme.AppCompat" parent="@style/Base.V23.Theme.AppCompat">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Theme.AppCompat.Light" parent="@style/Base.V23.Theme.AppCompat.Light">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Widget.AppCompat.Toolbar" parent="@style/Base.V7.Widget.AppCompat.Toolbar">
        <item name="android:touchscreenBlocksFocus">true</item>
        <item name="android:keyboardNavigationCluster">true</item>
    </style>
</resources>
