<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape>
            <solid android:color="@color/b1_color" />
            <corners android:radius="99.0dip" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_checked="false">
        <shape>
            <solid android:color="#fffefefe" />
            <corners android:radius="99.0dip" />
            <stroke android:width="1.5dip" android:color="@color/stroke_3" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/b1_color" />
            <corners android:radius="99.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#fffefefe" />
            <corners android:radius="99.0dip" />
            <stroke android:width="1.5dip" android:color="@color/stroke_4" />
        </shape>
    </item>
</selector>