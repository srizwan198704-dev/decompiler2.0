<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.3" android:thicknessRatio="15.0" android:useLevel="false" android:type="sweep">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270.0" android:toDegrees="270.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadiusRatio="2.3" android:thicknessRatio="15.0" android:angle="0.0" android:type="sweep">
                <gradient android:startColor="@color/green_primary" android:endColor="@color/red_primary" android:angle="180.0" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>