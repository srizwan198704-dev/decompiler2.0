<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="75.0dip" />
            <solid android:color="#6cfcfc32" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="75.0dip" />
            <solid android:color="#6cfcfc32" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="75.0dip" />
            <solid android:color="#6cfcfc32" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="75.0dip" />
            <solid android:color="#6cfcfc32" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="75.0dip" />
            <gradient android:startColor="#fffcfc32" android:endColor="#ffffe733" android:angle="0.0" />
        </shape>
    </item>
</selector>