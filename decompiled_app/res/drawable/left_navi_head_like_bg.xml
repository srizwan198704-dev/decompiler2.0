<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/transparent" />
            <stroke android:width="1.0px" android:color="@color/c_99ffffff" />
            <size android:height="@dimen/dp_23" android:width="@dimen/dp_80" />
            <corners android:radius="@dimen/dp_12" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle" android:useLevel="false">
            <solid android:color="@color/c_99ffffff" />
            <stroke android:width="1.0px" android:color="@color/white" />
            <size android:height="@dimen/dp_23" android:width="@dimen/dp_80" />
            <corners android:radius="@dimen/dp_12" />
        </shape>
    </item>
</selector>