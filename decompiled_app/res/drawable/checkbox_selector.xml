<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/m3_c_2E85FF" />
                    <corners android:radius="12.0dip" />
                    <size android:height="24.0dip" android:width="24.0dip" />
                </shape>
            </item>
            <item android:gravity="center" android:drawable="@drawable/ic_checkmark_select" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.0dip" android:color="@color/m3_white" />
                    <corners android:radius="12.0dip" />
                    <size android:height="24.0dip" android:width="24.0dip" />
                </shape>
            </item>
            <item android:gravity="center" android:drawable="@drawable/ic_checkmark_unselect" />
        </layer-list>
    </item>
</selector>