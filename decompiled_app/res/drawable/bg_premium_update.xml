<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="999.0dip" />
            <gradient android:startColor="#ff745624" android:endColor="#ff92754a" android:angle="45.0" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999.0dip" />
            <gradient android:startColor="#ff745624" android:endColor="#ff92754a" android:angle="45.0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="999.0dip" />
            <gradient android:startColor="#ff745624" android:endColor="#ff92754a" android:angle="45.0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999.0dip" />
            <gradient android:startColor="#ff82602a" android:endColor="#ffa38353" android:angle="45.0" />
        </shape>
    </item>
</selector>