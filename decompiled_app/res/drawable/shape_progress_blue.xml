<?xml version="1.0" encoding="utf-8"?>
<layer-list android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <stroke android:width="1.6699829dip" android:color="@color/status_bar_color" />
            <corners android:radius="3.0dip" />
            <solid android:color="@color/progress_text" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="3.0dip" />
                <solid android:color="@color/btn_color_blue" />
            </shape>
        </clip>
    </item>
</layer-list>