<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <nine-patch android:src="@drawable/ic_cvm_create_product_item_fold_bg" />
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <nine-patch android:src="@drawable/ic_cvm_create_product_item_expanded_bg" />
            </item>
            <item>
                <shape>
                    <corners android:radius="8.0dip" />
                    <stroke android:width="2.0dip" android:color="@color/b1_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <nine-patch android:src="@drawable/sold_out" />
    </item>
</selector>