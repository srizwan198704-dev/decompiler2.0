<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <inset android:insetTop="@dimen/player_seekbar_progress_inset" android:insetBottom="@dimen/player_seekbar_progress_inset">
            <shape>
                <stroke android:width="0.0dip" />
                <corners android:radius="2.0dip" />
                <solid android:color="#34ffffff" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <inset android:insetTop="@dimen/player_seekbar_progress_inset" android:insetBottom="@dimen/player_seekbar_progress_inset">
                <shape>
                    <gradient android:startColor="#fff28756" android:endColor="#fffcc534" android:angle="0.0" />
                    <corners android:radius="2.0dip" />
                </shape>
            </inset>
        </clip>
    </item>
</layer-list>