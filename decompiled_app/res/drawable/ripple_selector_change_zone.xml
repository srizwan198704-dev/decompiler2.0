<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/b7_color"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <solid android:color="@color/b7_color" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <layer-list>
                    <item android:drawable="@drawable/coupon_bg1" />
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="7.0dip" />
                            <stroke android:width="2.0dip" android:color="@color/primary" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:drawable="@drawable/coupon_bg1" />
        </selector>
    </item>
</ripple>