.class public interface abstract Lcom/github/szbinding/IProgress;
.super Ljava/lang/Object;


# virtual methods
.method public abstract setCompleted(J)V
    .annotation system Ldalvik/annotation/Throws;
        value = {
            Lcom/github/szbinding/SevenZipException;
        }
    .end annotation
.end method

.method public abstract setTotal(J)V
    .annotation system Ldalvik/annotation/Throws;
        value = {
            Lcom/github/szbinding/SevenZipException;
        }
    .end annotation
.end method
