.class public Lk7;
.super Lpk3;


# direct methods
.method public constructor <init>(Llk3;Lh8;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lpk3;-><init>(Llk3;Lql7;)V

    return-void
.end method

.method public constructor <init>([BLh8;)V
    .locals 2

    new-instance v0, Llk3;

    const/4 v1, 0x0

    invoke-direct {v0, p1, v1, v1}, Llk3;-><init>([BLᕑ;Lk05;)V

    invoke-direct {p0, v0, p2}, Lk7;-><init>(Llk3;Lh8;)V

    return-void
.end method
