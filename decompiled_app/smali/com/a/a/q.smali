02\u0002\u0ae3\u0ac5\u0003\u0002\u0002\u0002\u0ae3\u0acb\u0003\u0002\u0002\u0002\u0ae3\u0ad1\u0003\u0002\u0002\u0002\u0ae3\u0ad7\u0003\u0002\u0002\u0002\u0ae3\u0add\u0003\u0002\u0002\u0002\u0ae4\u00c6\u0003\u0002\u0002\u0002\u0ae5\u0ae6\u0007c\u0002\u0002\u0ae6\u0ae7\u0007f\u0002\u0002\u0ae7\u0ae8\u0007f\u0002\u0002\u0ae8\u0ae9\u0007/\u0002\u0002\u0ae9\u0aea\u0007k\u0002\u0002\u0aea\u0aeb\u0007p\u0002\u0002\u0aeb\u0aec\u0007v\u0002\u0002\u0aec\u0aed\u00071\u0002\u0002\u0aed\u0aee\u0007n\u0002\u0002\u0aee\u0aef\u0007k\u0002\u0002\u0aef\u0af0\u0007v\u0002\u0002\u0af0\u0b6b\u0007:\u0002\u0002\u0af1\u0af2\u0007t\u0002\u0002\u0af2\u0af3\u0007u\u0002\u0002\u0af3\u0af4\u0007w\u0002\u0002\u0af4\u0af5\u0007d\u0002\u0002\u0af5\u0af6\u0007/\u0002\u0002\u0af6\u0af7\u0007k\u0002\u0002\u0af7\u0af8\u0007p\u0002\u0002\u0af8\u0af9\u0007v\u0002\u0002\u0af9\u0afa\u00071\u0002\u0002\u0afa\u0afb\u0007n\u0002\u0002\u0afb\u0afc\u0007k\u0002\u0002\u0afc\u0afd\u0007v\u0002\u0002\u0afd\u0b6b\u0007:\u0002\u0002\u0afe\u0aff\u0007o\u0002\u0002\u0aff\u0b00\u0007w\u0002\u0002\u0b00\u0b01\u0007n\u0002\u0002\u0b01\u0b02\u0007/\u0002\u0002\u0b02\u0b03\u0007k\u0002\u0002\u0b03\u0b04\u0007p\u0002\u0002\u0b04\u0b05\u0007v\u0002\u0002\u0b05\u0b06\u00071\u0002\u0002\u0b06\u0b07\u0007n\u0002\u0002\u0b07\u0b08\u0007k\u0002\u0002\u0b08\u0b09\u0007v\u0002\u0002\u0b09\u0b6b\u0007:\u0002\u0002\u0b0a\u0b0b\u0007f\u0002\u0002\u0b0b\u0b0c\u0007k\u0002\u0002\u0b0c\u0b0d\u0007x\u0002\u0002\u0b0d\u0b0e\u0007/\u0002\u0002\u0b0e\u0b0f\u0007k\u0002\u0002\u0b0f\u0b10\u0007p\u0002\u0002\u0b10\u0b11\u0007v\u0002\u0002\u0b11\u0b12\u00071\u0002\u0002\u0b12\u0b13\u0007n\u0002\u0002\u0b13\u0b14\u0007k\u0002\u0002\u0b14\u0b15\u0007v\u0002\u0002\u0b15\u0b6b\u0007:\u0002\u0002\u0b16\u0b17\u0007t\u0002\u0002\u0b17\u0b18\u0007g\u0002\u0002\u0b18\u0b19\u0007o\u0002\u0002\u0b19\u0b1a\u0007/\u0002\u0002\u0b1a\u0b1b\u0007k\u0002\u0002\u0b1b\u0b1c\u0007p\u0002\u0002\u0b1c\u0b1d\u0007v\u0002\u0002\u0b1d\u0b1e\u00071\u0002\u0002\u0b1e\u0