07p\u0002\u0002\u0de7\u0f6d\u0007i\u0002\u0002\u0de8\u0de9\u0007c\u0002\u0002\u0de9\u0dea\u0007i\u0002\u0002\u0dea\u0deb\u0007g\u0002\u0002\u0deb\u0f6d\u0007v\u0002\u0002\u0dec\u0ded\u0007c\u0002\u0002\u0ded\u0dee\u0007i\u0002\u0002\u0dee\u0def\u0007g\u0002\u0002\u0def\u0df0\u0007v\u0002\u0002\u0df0\u0df1\u0007/\u0002\u0002\u0df1\u0df2\u0007y\u0002\u0002\u0df2\u0df3\u0007k\u0002\u0002\u0df3\u0df4\u0007f\u0002\u0002\u0df4\u0f6d\u0007g\u0002\u0002\u0df5\u0df6\u0007c\u0002\u0002\u0df6\u0df7\u0007i\u0002\u0002\u0df7\u0df8\u0007g\u0002\u0002\u0df8\u0df9\u0007v\u0002\u0002\u0df9\u0dfa\u0007/\u0002\u0002\u0dfa\u0dfb\u0007q\u0002\u0002\u0dfb\u0dfc\u0007d\u0002\u0002\u0dfc\u0dfd\u0007l\u0002\u0002\u0dfd\u0dfe\u0007g\u0002\u0002\u0dfe\u0dff\u0007e\u0002\u0002\u0dff\u0f6d\u0007v\u0002\u0002\u0e00\u0e01\u0007c\u0002\u0002\u0e01\u0e02\u0007i\u0002\u0002\u0e02\u0e03\u0007g\u0002\u0002\u0e03\u0e04\u0007v\u0002\u0002\u0e04\u0e05\u0007/\u0002\u0002\u0e05\u0e06\u0007d\u0002\u0002\u0e06\u0e07\u0007q\u0002\u0002\u0e07\u0e08\u0007q\u0002\u0002\u0e08\u0e09\u0007n\u0002\u0002\u0e09\u0e0a\u0007g\u0002\u0002\u0e0a\u0e0b\u0007c\u0002\u0002\u0e0b\u0f6d\u0007p\u0002\u0002\u0e0c\u0e0d\u0007c\u0002\u0002\u0e0d\u0e0e\u0007i\u0002\u0002\u0e0e\u0e0f\u0007g\u0002\u0002\u0e0f\u0e10\u0007v\u0002\u0002\u0e10\u0e11\u0007/\u0002\u0002\u0e11\u0e12\u0007d\u0002\u0002\u0e12\u0e13\u0007{\u0002\u0002\u0e13\u0e14\u0007v\u0002\u0002\u0e14\u0f6d\u0007g\u0002\u0002\u0e15\u0e16\u0007c\u0002\u0002\u0e16\u0e17\u0007i\u0002\u0002\u0e17\u0e18\u0007g\u0002\u0002\u0e18\u0e19\u0007v\u0002\u0002\u0e19\u0e1a\u0007/\u0002\u0002\u0e1a\u0e1b\u0007e\u0002\u0002\u0e1b\u0e1c\u0007j\u0002\u0002\u0e1c\u0e1d\u0007c\u0002\u0002\u0e1d\u0f6d\u0007t\u0002\u0002\u0e1e\u0e1f\u0007c\u0002\u0002\u0e1f\u0e20\u0007i\u0002\u0002\u0e20\u0e21\u0007g\u0002\u0002\u0e21\u0e22\u0007v\u0002\u0002\u0e22\u0e23\u0007/\u0002\u0002\u0e23\u0e24\u0007u\u0002\u0002\u0e24\u0e25\u0007j\u0002\u0002\u0e25\u0e26\u0007q\u0002\u0002\u0e26\u0e27\u0007t\u0002\u0002\