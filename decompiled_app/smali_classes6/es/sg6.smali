.class public Les/sg6;
.super Les/lv;


# direct methods
.method public constructor <init>(Ljava/io/File;)V
    .locals 0

    invoke-direct {p0, p1}, Les/lv;-><init>(Ljava/io/File;)V

    return-void
.end method

.method public constructor <init>(Ljava/io/File;Ljava/io/File;Les/tr1;)V
    .locals 0

    invoke-direct {p0, p1, p2, p3}, Les/lv;-><init>(Ljava/io/File;Ljava/io/File;Les/tr1;)V

    return-void
.end method
